# Database: Supabase PostgreSQL URL now; AWS RDS PostgreSQL URL later.
DB_URL=jdbc:postgresql://localhost:5432/bookzzang
DB_USERNAME=bookzzang
DB_PASSWORD=change-me

# Kakao REST API key. Do not commit AUTH_KEY.env or real secrets.
KAKAO_API_KEY=

# AWS SES: use a verified sender identity in the selected SES region.
AWS_SES_REGION=ap-northeast-2
AWS_SES_SENDER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Generate a random 32+ character value; used only to hash verification codes/tokens.
EMAIL_VERIFICATION_SECRET=

# Generate each as a distinct 32-byte Base64 value. Keep only in .env / AWS Secrets Manager.
PII_ENCRYPTION_KEY=
PII_EMAIL_LOOKUP_KEY=
